{
  "redirects": [
    { "source": "/app", "destination": "/", "permanent": true },
    { "source": "/app/:path*", "destination": "/", "permanent": true },
    { "source": "/login", "destination": "/", "permanent": true },
    { "source": "/admin", "destination": "/", "permanent": true },
    { "source": "/settings", "destination": "/", "permanent": true },
    { "source": "/inbox", "destination": "/", "permanent": true },
    { "source": "/collections", "destination": "/", "permanent": true },
    { "source": "/collections/:path*", "destination": "/", "permanent": true },
    { "source": "/c/:path*", "destination": "/", "permanent": true },
    { "source": "/reading", "destination": "/", "permanent": true },
    { "source": "/reading/:path*", "destination": "/", "permanent": true },
    { "source": "/g/:path*", "destination": "/", "permanent": true },
    { "source": "/notebook", "destination": "/", "permanent": true },
    { "source": "/notebook/:path*", "destination": "/", "permanent": true },
    { "source": "/n/:path*", "destination": "/", "permanent": true },
    { "source": "/groups", "destination": "/", "permanent": true },
    { "source": "/groups/:path*", "destination": "/", "permanent": true },
    { "source": "/profile", "destination": "/", "permanent": true },
    { "source": "/profile/:path*", "destination": "/", "permanent": true },
    { "source": "/u/:path*", "destination": "/", "permanent": true },
    { "source": "/native-editor", "destination": "/", "permanent": true },
    { "source": "/native-phase0", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self' https://grok.com https://*.grok.com; form-action 'self' https://accounts.google.com https://appleid.apple.com; script-src 'self' 'unsafe-inline' https://grok.com https://accounts.google.com https://appleid.apple.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://katecheo.app https://*.katecheo.app https://verse2note.com https://*.verse2note.com https://accounts.google.com https://appleid.apple.com https://*.googleapis.com https://*.gstatic.com https://grok.com https://*.grok.com wss:; frame-src 'self' https://accounts.google.com https://appleid.apple.com; worker-src 'self' blob:; manifest-src 'self'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
